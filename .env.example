# FDR SmartTrack Environment Configuration

# Application
ENVIRONMENT=development
PROJECT_NAME="FDR SmartTrack"
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Dedicated PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fdr_smarttrack_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fdr_smarttrack_test_db

# File Uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# OCR & AI
TESSERACT_CMD=
ENABLE_ANOMALY_MODEL=true

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Notifications
ENABLE_BACKGROUND_SCHEDULER=true
ALERT_WINDOWS_DAYS=[90,60,30,7,1]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fdr-smarttrack.local
